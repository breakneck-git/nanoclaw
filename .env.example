TELEGRAM_BOT_TOKEN=

# Agent model (optional). Overrides the built-in default (sonnet).
# Accepts a FAMILY ALIAS — opus | sonnet | haiku — which auto-resolves to the
# current version of that family (just like `claude --model opus` in the CLI),
# or a pinned full id like claude-opus-4-8. Changing this needs only a NanoClaw
# restart — no container rebuild.
# Per-group override: put AGENT_MODEL=... in data/env/<group-folder>.env
# (operator-controlled; applies to any group including main).
# AGENT_MODEL=opus

# Agent effort (optional): low | medium | high | max. 'high' is the SDK default;
# 'max' is Opus-only. Same global + per-group resolution as AGENT_MODEL.
# AGENT_EFFORT=high
