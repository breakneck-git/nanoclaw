TELEGRAM_BOT_TOKEN=

# Agent model (optional). Overrides the built-in default (claude-sonnet-4-6).
# Set any valid model id, e.g. claude-opus-4-8 for max capability.
# Changing this needs only a NanoClaw restart — no container rebuild.
# Per-group override: put AGENT_MODEL=... in data/env/<group-folder>.env.
# AGENT_MODEL=claude-opus-4-8
